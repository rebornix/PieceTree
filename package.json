{
    "name": "vscode-piece-tree",
    "version": "1.2.0",
    "description": "Piece Tree",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "scripts": {
        "start": "npm run build && npm run watch",
        "build": "tsc -p tsconfig.build.json",
        "watch": "tsc -p tsconfig.build.json -w",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "pretest": "npm run build",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "fasttest": "jest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rebornix/PieceTree.git"
    },
    "author": "rebornix",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/rebornix/PieceTree/issues"
    },
    "homepage": "https://github.com/rebornix/PieceTree#readme",
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "typescript": "^5.7.2"
    }
}
